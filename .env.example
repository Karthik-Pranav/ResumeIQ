# ─────────────────────────────────────────────────────────────
#  ResumeIQ — Backend Environment Variables
#  Copy this file to .env and fill in any values you want to
#  change. Every variable has a safe default so the app works
#  even if .env is absent.
# ─────────────────────────────────────────────────────────────

# ── Sentence-transformer model ────────────────────────────────
# The model is downloaded automatically on first startup (~90 MB).
# Swap this for any compatible sentence-transformers model.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Semantic skill matching threshold (0.0 – 1.0) ────────────
# A skill phrase is considered "present" in the resume if its
# max cosine similarity against any resume sentence meets this.
# Lower  → more permissive (catches loose synonyms)
# Higher → stricter (near-exact semantic matches only)
SKILL_THRESHOLD=0.45

# ── Job description expansion ─────────────────────────────────
# JDs with fewer meaningful tokens than this are considered weak.
JD_WEAK_THRESHOLD=5

# Maximum skills added when a weak JD is auto-expanded.
JD_MAX_EXPANSION_SKILLS=8

# ── Results caps ─────────────────────────────────────────────
# Max strengths / gaps returned per analysis.
MAX_STRENGTHS=6
MAX_GAPS=6

# Number of top resume chunks returned in matched_sections.
TOP_K_SECTIONS=3

# ── File upload limits ────────────────────────────────────────
# Maximum PDF upload size in megabytes.
MAX_FILE_SIZE_MB=5

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * for development; set explicit origins in production.
# Example: ALLOWED_ORIGINS=https://resumeiq.yourdomain.com
ALLOWED_ORIGINS=*
