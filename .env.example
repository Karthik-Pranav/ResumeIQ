# ─────────────────────────────────────────────────────────────
#  ResumeIQ — Environment Variable Reference
#  Copy this file to .env and adjust any values.
#  All variables have sensible defaults; the app runs without
#  a .env file in development.
# ─────────────────────────────────────────────────────────────

# ── AI / Embeddings ───────────────────────────────────────────
# Sentence-transformer model used for semantic matching.
# Downloaded automatically on first startup (~90 MB).
# Swap for any compatible model from sentence-transformers.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── AI Feedback (Optional) ────────────────────────────────────
# When set, the /analyze endpoint generates personalised
# LLM feedback via OpenAI GPT-3.5-turbo.
# Without this key the endpoint falls back to a deterministic
# rule-based summary (no functionality is lost).
OPENAI_API_KEY=

# ── File Upload ────────────────────────────────────────────────
# Maximum PDF size accepted by the /analyze endpoint (MB).
MAX_FILE_SIZE_MB=5

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * for local development.
# Production example:
#   ALLOWED_ORIGINS=https://resumeiq.yourdomain.com
ALLOWED_ORIGINS=*

# ── Rate Limiting ─────────────────────────────────────────────
# Maximum /analyze requests per minute per client IP.
# Raise this for trusted internal deployments.
RATE_LIMIT_RPM=10
